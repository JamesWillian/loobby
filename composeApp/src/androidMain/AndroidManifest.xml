<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Necessária para o ConnectivityObserver detectar estado da rede (modo offline). -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <!-- Obrigatória em Android 13+ para exibir notificações. O app deve pedir em runtime. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- O app não tem anúncios: sai o ID de publicidade e as medições de anúncios do
         Android que o Analytics traz por padrão. -->
    <uses-permission
        android:name="com.google.android.gms.permission.AD_ID"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.ACCESS_ADSERVICES_AD_ID"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.ACCESS_ADSERVICES_ATTRIBUTION"
        tools:node="remove" />

    <application
        android:name=".FourPlayersApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_fourplayers"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_fourplayers_round"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity
            android:exported="true"
            android:name=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Recebe pushes do FCM e monta notificação local com deep link por eventId -->
        <service
            android:name=".feature.notifications.platform.FourPlayersMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
        <!-- Com o app em segundo plano é o FCM quem mostra o push, e sem isto ele usaria o
             ícone do app, que na barra de status vira um círculo liso. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_stat_fourplayers" />

        <!-- Relatórios de falhas: o build type decide, e no debug ficam desligados. -->
        <meta-data
            android:name="firebase_crashlytics_collection_enabled"
            android:value="${crashlyticsEnabled}" />
        <!-- Números de uso: o build type decide, e no debug a coleta fica desativada. -->
        <meta-data
            android:name="firebase_analytics_collection_deactivated"
            android:value="${analyticsDeactivated}" />
        <!-- Sem anúncios: nada de ID de publicidade nem de sinais para personalizar anúncios. -->
        <meta-data
            android:name="google_analytics_adid_collection_enabled"
            android:value="false" />
        <meta-data
            android:name="google_analytics_default_allow_ad_personalization_signals"
            android:value="false" />
        <!-- O app tem uma Activity só, e a contagem automática chamaria tudo de MainActivity:
             quem conta as telas é o TrackScreen, com nomes fixos. -->
        <meta-data
            android:name="google_analytics_automatic_screen_reporting_enabled"
            android:value="false" />
    </application>

</manifest>
